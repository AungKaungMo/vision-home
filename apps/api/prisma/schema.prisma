generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum DesignStatus {
  draft
  active
  archived

  @@map("design_status")
}

enum DesignVisibility {
  private
  unlisted
  public

  @@map("design_visibility")
}

enum DesignType {
  single_room

  @@map("design_type")
}

enum DesignSource {
  generated
  edited

  @@map("design_source")
}

enum RoomTypeSource {
  user
  detected

  @@map("room_type_source")
}

enum AssetType {
  source
  generated

  @@map("asset_type")
}

enum GenerationStatus {
  pending
  queued
  processing
  completed
  failed
  cancelled

  @@map("generation_status")
}

model User {
  id        String  @id @default(uuid()) @db.Uuid
  clerkId   String  @unique(map: "users_clerk_id_key") @map("clerk_id") @db.VarChar(255)
  email     String  @db.VarChar(320)
  username  String  @unique(map: "users_username_key") @db.VarChar(30)
  fullName  String? @map("full_name") @db.VarChar(120)
  avatarUrl String? @map("avatar_url") @db.Text
  bio       String? @db.VarChar(300)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  designs Design[]

  @@map("users")
}

model Design {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  type   DesignType
  source DesignSource @default(generated)

  title       String  @db.VarChar(120)
  description String? @db.VarChar(500)

  status     DesignStatus     @default(draft)
  visibility DesignVisibility @default(private)

  isFavorite Boolean @default(false) @map("is_favorite")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@index([ownerId, updatedAt], map: "designs_owner_updated_idx")
  @@index([ownerId, type], map: "designs_owner_type_idx")
  @@index([visibility, createdAt], map: "designs_visibility_created_idx")
  @@map("designs")
}

model RoomType {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique(map: "room_types_code_key") @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  sampleImageKeys String[] @default([]) @map("sample_image_keys")
  promptHint      String?  @map("prompt_hint") @db.Text

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@index([isActive, sortOrder], map: "room_types_active_sort_idx")
  @@map("room_types")
}

model DesignStyle {
  id String @id @default(uuid()) @db.Uuid

  code String @unique(map: "design_styles_code_key") @db.VarChar(50)
  name String @db.VarChar(100)

  promptHint String? @map("prompt_hint") @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  generations GenerationDesignStyle[]

  @@index([isActive], map: "design_styles_active_idx")
  @@map("design_styles")
}

model Room {
  id String @id @default(uuid()) @db.Uuid

  designId   String  @map("design_id") @db.Uuid
  roomTypeId String? @map("room_type_id") @db.Uuid

  roomTypeSource RoomTypeSource? @map("room_type_source")
  roomTypeLabel  String?         @map("room_type_label") @db.VarChar(100)

  name        String? @db.VarChar(120)
  description String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  design      Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  roomType    RoomType?    @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  assets      Asset[]
  generations Generation[]

  @@index([designId, createdAt], map: "rooms_design_created_idx")
  @@index([roomTypeId], map: "rooms_room_type_idx")
  @@map("rooms")
}

model GenerationDesignStyle {
  generationId  String @map("generation_id") @db.Uuid
  designStyleId String @map("design_style_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  generation  Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  designStyle DesignStyle @relation(fields: [designStyleId], references: [id], onDelete: Restrict)

  @@id([generationId, designStyleId])
  @@index([designStyleId], map: "generation_design_styles_style_idx")
  @@map("generation_design_styles")
}

model Asset {
  id String @id @default(uuid()) @db.Uuid

  roomId       String  @map("room_id") @db.Uuid
  generationId String? @map("generation_id") @db.Uuid

  type AssetType

  // The design style a `generated` output renders; null for `source` assets.
  styleCode String? @map("style_code") @db.VarChar(50)

  storageKey String @unique(map: "assets_storage_key_key") @map("storage_key") @db.VarChar(500)
  mimeType   String @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt @map("size_bytes")
  width      Int
  height     Int

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  room                 Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  generation           Generation?  @relation("GenerationOutputs", fields: [generationId], references: [id], onDelete: SetNull)
  sourceForGenerations Generation[] @relation("GenerationSourceAsset")

  @@index([roomId, createdAt], map: "assets_room_created_idx")
  @@index([generationId], map: "assets_generation_idx")
  @@map("assets")
}

model Generation {
  id String @id @default(uuid()) @db.Uuid

  roomId        String @map("room_id") @db.Uuid
  sourceAssetId String @map("source_asset_id") @db.Uuid

  provider          String  @default("fal") @db.VarChar(50)
  providerRequestId String? @map("provider_request_id") @db.VarChar(255)
  modelId           String  @map("model_id") @db.VarChar(255)

  status     GenerationStatus @default(pending)
  parameters Json             @db.JsonB

  additionalDetails String? @map("additional_details") @db.Text

  errorCode    String? @map("error_code") @db.VarChar(100)
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  room         Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sourceAsset  Asset                   @relation("GenerationSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  assets       Asset[]                 @relation("GenerationOutputs")
  designStyles GenerationDesignStyle[]

  @@unique([provider, providerRequestId], map: "generations_provider_request_unique")
  @@index([roomId, createdAt], map: "generations_room_created_idx")
  @@index([status, createdAt], map: "generations_status_created_idx")
  @@map("generations")
}
